# OWL_AI — copy to .env.local (never commit .env.local). Only VITE_* variables reach the browser; these do not.
# Official model: Qwen3 1.7B Instruct GGUF Q4_K_M (Qwen3-1.7B-Q4_K_M.gguf), llama.cpp b12532, CPU only.
LLAMA_URL=http://127.0.0.1:8080
OWL_AI_MODEL=qwen3-1.7b
# Same value you pass to llama-server --api-key (leave empty if the server runs without a key):
OWL_AI_API_KEY=
# Qwen3 thinking is OFF by default; set 0 only to experiment:
# OWL_AI_NO_THINK=0
# OWL_AI_ALLOWED_ORIGINS=https://aistudioowl.vercel.app
# OWL_AI_RATE_MAX=15
# OWL_AI_MAX_ACTIVE=2
# Phase 2 (Cloudflare Tunnel + Access service token):
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
